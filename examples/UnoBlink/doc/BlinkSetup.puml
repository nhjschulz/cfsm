@startuml CFSM state

autoactivate on

participant Arduino
participant Main
participant Cfsm
participant OnState
participant OffState
Actor Led

Arduino -> Main: setup()
Main -> Cfsm : init fsm context
Main <-- Cfsm
Main -> Cfsm : transition(OnState)
Cfsm -> OnState : onEnter()
OnState -> Led #LightGray : turn on
Cfsm <-- OnState
Main <-- Cfsm
Arduino <-- Main

@enduml